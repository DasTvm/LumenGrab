{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumenGrab",
  "version": "0.1.2",
  "identifier": "app.lumengrab",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: lgcapture: http://lgcapture.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBRjM1QjdCMjQwODk1ODcKUldTSGxRZ2tlMXZ6bWxNblpkWk9tcC9rUm1ZSWNuRDNBUUFGbngvaUpRc2NyME1UQURaeWlMRnQK",
      "endpoints": ["https://github.com/DasTvm/LumenGrab/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lumengrab"],
        "name": "LumenGrab Document",
        "description": "LumenGrab document",
        "mimeType": "application/vnd.lumengrab",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "app.lumengrab.document",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
